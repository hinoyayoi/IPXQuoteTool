<Window x:Class="IPXQuoteTool.DeveloperModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开发者模式"
        Width="620"
        Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#F8FAFC" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="开发者模式" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
            <TextBlock Text="请选择需要使用的开发者功能。"
                       Foreground="#64748B"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,18,0,0">
            <Button Content="单文件费用估算"
                    Width="130"
                    Height="34"
                    Click="ShowSingleFilePanel_Click"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"/>
        </WrapPanel>

        <Grid x:Name="singleFilePanel" Grid.Row="2" Margin="0,18,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="图纸文件" VerticalAlignment="Center" Foreground="#475569"/>
            <TextBox x:Name="txtSingleFilePath"
                     Grid.Column="1"
                     Height="34"
                     Padding="8"
                     VerticalContentAlignment="Center"
                     BorderBrush="#CBD5E1"
                     BorderThickness="1"/>
            <Button Grid.Column="2"
                    Content="浏览"
                    Width="64"
                    Height="34"
                    Margin="8,0,0,0"
                    Click="Browse_Click"/>
            <Button Grid.Column="3"
                    Content="关闭"
                    Width="64"
                    Height="34"
                    Margin="8,0,0,0"
                    Click="CloseSingleFilePanel_Click"
                    Background="#E2E8F0"
                    Foreground="#334155"
                    BorderThickness="0"/>

            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Grid.ColumnSpan="3"
                       Text="启用后，运行费用估算时只处理该单个 CAD 文件；关闭会恢复目录批量模式。"
                       Foreground="#64748B"
                       Margin="0,10,0,0"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnEnableSingleFile"
                    Content="启用单文件费用估算"
                    Width="150"
                    Height="34"
                    Margin="0,0,10,0"
                    Click="Enable_Click"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Visibility="Collapsed"/>
            <Button Content="关闭并恢复"
                    Width="100"
                    Height="34"
                    Click="CloseAndReset_Click"
                    Background="#E2E8F0"
                    Foreground="#334155"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>

