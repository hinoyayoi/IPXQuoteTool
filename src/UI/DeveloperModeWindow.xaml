<Window x:Class="IPXQuoteTool.DeveloperModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开发者模块"
        Width="620"
        Height="220"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#F8FAFC" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="单文件报价" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="图纸文件" VerticalAlignment="Center" Foreground="#475569"/>
            <TextBox x:Name="txtSingleFilePath"
                     Grid.Column="1"
                     Height="34"
                     Padding="8"
                     VerticalContentAlignment="Center"
                     BorderBrush="#CBD5E1"
                     BorderThickness="1"/>
            <Button Grid.Column="2"
                    Content="浏览"
                    Width="64"
                    Height="34"
                    Margin="8,0,0,0"
                    Click="Browse_Click"/>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="启用后，运行报价时只处理该单个 SolidWorks 文件；关闭会恢复目录批量模式。"
                   Foreground="#64748B"
                   Margin="84,10,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="启用单文件报价"
                    Width="120"
                    Height="34"
                    Margin="0,0,10,0"
                    Click="Enable_Click"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"/>
            <Button Content="关闭并恢复"
                    Width="100"
                    Height="34"
                    Click="CloseAndReset_Click"
                    Background="#E2E8F0"
                    Foreground="#334155"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
