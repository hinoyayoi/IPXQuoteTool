<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <EnableComHosting>true</EnableComHosting>
    <ApplicationIcon>src\UI\IPXQuotation.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="src\UI\App.xaml" />
    <Page Include="src\UI\MainWindow.xaml" />
    <Page Include="src\UI\DeveloperModeWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>lib\SolidWorks\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>lib\SolidWorks\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>lib\SolidWorks\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
    <Reference Include="SolidWorks.Interop.swdocumentmgr">
      <HintPath>lib\SolidWorks\SolidWorks.Interop.swdocumentmgr.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="src\UI\IPXQuotation.ico" />
    <None Include="resources\Templates\对象系数.xlsx" Link="对象系数.xlsx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyCreoPluginToOutput" AfterTargets="Build">
    <PropertyGroup>
      <CreoPluginDllPath>$(MSBuildProjectDirectory)\bridges\CreoPlugin\x64\$(Configuration)\IPXQuoteCreoPlugin.dll</CreoPluginDllPath>
      <CreoPluginOutputDirectory>$(OutDir)creo-plugin\</CreoPluginOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
      <CreoPluginTextFiles Include="$(MSBuildProjectDirectory)\bridges\CreoPlugin\text\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(CreoPluginOutputDirectory)" Condition="Exists('$(CreoPluginDllPath)')" />
    <MakeDir Directories="$(CreoPluginOutputDirectory)text\" Condition="Exists('$(CreoPluginDllPath)')" />
    <Copy SourceFiles="$(CreoPluginDllPath)" DestinationFolder="$(CreoPluginOutputDirectory)" SkipUnchangedFiles="true" Condition="Exists('$(CreoPluginDllPath)')" />
    <Copy SourceFiles="@(CreoPluginTextFiles)" DestinationFiles="@(CreoPluginTextFiles->'$(CreoPluginOutputDirectory)text\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="Exists('$(CreoPluginDllPath)')" />
    <Warning Text="未找到 Creo 插件 DLL：$(CreoPluginDllPath)。如需调试 Creo 报价，请先生成 bridges\CreoPlugin。" Condition="!Exists('$(CreoPluginDllPath)')" />
  </Target>
</Project>
